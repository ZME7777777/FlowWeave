# Copy this file to .local/remote-deploy.env, keep the copy out of version
# control, and restrict it to the owner (chmod 600). Do not put credentials,
# keys, or tokens here. Values below identify the approved deployment entry
# points; they are local operational facts, not repository configuration.
FLOWWEAVE_REMOTE_HOST=
FLOWWEAVE_REMOTE_USER=
FLOWWEAVE_REMOTE_ROOT=

# Paths are relative to FLOWWEAVE_REMOTE_ROOT, must not contain '..', and are
# validated read-only over SSH before a deployment.
FLOWWEAVE_REMOTE_COMPOSE_FILE=
FLOWWEAVE_REMOTE_ENV_FILE=
FLOWWEAVE_REMOTE_BUILD_ROOT=
FLOWWEAVE_REMOTE_IMAGE_ROOT=

# Use these only when stream-api is managed by a different Compose project.
# When it belongs to the main project, leave both values empty.
FLOWWEAVE_REMOTE_STREAM_COMPOSE_FILE=
FLOWWEAVE_REMOTE_STREAM_ENV_FILE=
