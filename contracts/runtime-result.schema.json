{
  "$id": "https://flowweave.local/contracts/runtime-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "outputs": {
      "additionalProperties": {
        "items": false,
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
