POSTGRES_DB=flowweave
POSTGRES_USER=flowweave
POSTGRES_PASSWORD=flowweave_dev
POSTGRES_PORT=55432
CREDENTIALS_MASTER_KEY=
RUNTIME_ADAPTER=openhands
EXECUTION_MODE=worker
RUNTIME_POLL_SECONDS=1
OPENHANDS_SESSION_API_KEY=flowweave-internal
INLINE_ARTIFACT_LIMIT=65536
CAPABILITY_IMPORT_TTL_SECONDS=900
TASK_LEASE_SECONDS=30
# Local Worker only: requires /var/run/docker.sock and grants host Docker control.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE_PYTHON=flowweave-sandbox-python:1
SANDBOX_IMAGE_JAVASCRIPT=flowweave-sandbox-javascript:1
VITE_API_BASE_URL=http://localhost:8080
