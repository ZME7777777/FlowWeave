POSTGRES_DB=flowweave
POSTGRES_USER=flowweave
POSTGRES_PASSWORD=flowweave_dev
POSTGRES_PORT=55432
CREDENTIALS_MASTER_KEY=
CREDENTIAL_SUBJECT_KEY=local-user
CREDENTIAL_INTERNAL_API_KEY=replace-with-a-long-random-internal-key
LARK_OAUTH_CLIENT_ID=
LARK_OAUTH_CLIENT_SECRET=
LARK_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/oauth/lark/callback
RUNTIME_ADAPTER=openhands
EXECUTION_MODE=worker
RUNTIME_POLL_SECONDS=1
OPENHANDS_SESSION_API_KEY=flowweave-internal
# Compose bind mounts. Defaults keep every node workspace and CLI state in this repository.
FLOWWEAVE_HOST_WORKSPACE_ROOT=../var/workspaces
FLOWWEAVE_HOST_LARK_CLI_HOME=../var/tool-state/lark-cli
INLINE_ARTIFACT_LIMIT=65536
CAPABILITY_IMPORT_TTL_SECONDS=900
DEPENDENCY_BUILDER_BACKEND=docker
DEPENDENCY_BUILDER_IMAGE=flowweave-dependency-builder:1
DEPENDENCY_BUILDER_NETWORK=bridge
DEPENDENCY_BUILDER_TIMEOUT_SECONDS=300
TERMINAL_ENVIRONMENT_BACKEND=docker
TERMINAL_ENVIRONMENT_BASE_IMAGE=flowweave-openhands-runtime:1
TERMINAL_ENVIRONMENT_SETUP_NETWORK=bridge
TERMINAL_ENVIRONMENT_RUNTIME_NETWORK=flowweave_runtime
TERMINAL_ENVIRONMENT_WORKSPACE_SOURCE_CONTAINER=flowweave-openhands-agent-server
TASK_LEASE_SECONDS=30
# Local Worker only: requires /var/run/docker.sock and grants host Docker control.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE_PYTHON=flowweave-sandbox-python:1
SANDBOX_IMAGE_JAVASCRIPT=flowweave-sandbox-javascript:1
VITE_API_BASE_URL=http://localhost:8080
