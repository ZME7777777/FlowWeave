POSTGRES_DB=flowweave
POSTGRES_USER=flowweave
POSTGRES_PASSWORD=flowweave_dev
POSTGRES_PORT=55432
FLOWWEAVE_BIND_ADDRESS=127.0.0.1
CREDENTIALS_MASTER_KEY=
RUNTIME_ADAPTER=openhands
EXECUTION_MODE=worker
RUNTIME_POLL_SECONDS=1
OPENHANDS_SESSION_API_KEY=flowweave-internal
# Compose bind mount for node workspaces. Lark CLI state is kept in a
# Controller-managed, per-environment Docker volume instead of on the host.
# Absolute path as seen by the Docker daemon. Compose defaults this to
# ${PWD}/var/workspaces; override it when Docker uses another host path.
FLOWWEAVE_RUNTIME_HOST_WORKSPACE_ROOT=
INLINE_ARTIFACT_LIMIT=65536
CAPABILITY_IMPORT_TTL_SECONDS=900
DEPENDENCY_BUILDER_BACKEND=docker
DEPENDENCY_BUILDER_IMAGE=flowweave-dependency-builder:1
DEPENDENCY_BUILDER_TIMEOUT_SECONDS=300
TERMINAL_ENVIRONMENT_BACKEND=docker
TERMINAL_ENVIRONMENT_SETUP_IMAGE=flowweave-openhands-runtime:1
SANDBOX_MANAGER_SCOPE=flowweave-local
SANDBOX_RECONCILE_BATCH_SIZE=50
SANDBOX_RUNTIME_IDLE_TTL_SECONDS=3600
SANDBOX_RUNTIME_HARD_TTL_SECONDS=86400
SANDBOX_STORAGE_SIZE=4g
TERMINAL_ENVIRONMENT_MAX_ACTIVE_SESSIONS=4
# egress is required for external model providers/MCP. Use isolated when all
# Runtime dependencies are reachable only through explicitly attached clients.
SANDBOX_RUNTIME_NETWORK_MODE=egress
DOCKER_CONTROLLER_MODE=remote
DOCKER_CONTROLLER_URL=http://runtime-provider:8090
# Linux: set this to `stat -c '%g' /var/run/docker.sock`; Docker Desktop uses 0.
DOCKER_SOCKET_GID=0
# Use two different random values (minimum 32 characters each).
DOCKER_CONTROLLER_API_KEY=replace-with-a-long-random-api-controller-key
DOCKER_CONTROLLER_WORKER_API_KEY=replace-with-a-different-long-random-worker-controller-key
TASK_LEASE_SECONDS=30
# API and Worker call the isolated runtime-provider; neither mounts Docker Socket.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE_PYTHON=flowweave-sandbox-python:1
SANDBOX_IMAGE_JAVASCRIPT=flowweave-sandbox-javascript:1
VITE_API_BASE_URL=http://localhost:8080
